# Committed: no secrets here. Secrets for this environment live in .env.development.local (ignored by
# git; made by likho-infra/scripts/make-env-secrets.py) or in Kubernetes Secrets (likho-deploy).
# Read order: .env, .env.local, .env.development, .env.development.local; a real environment variable wins.

LIKHO_ENV=development
LOG_LEVEL=INFO
GRPC_PORT=5020
HTTP_PORT=4020

# The likho-infra local stack
NATS_URL=nats://localhost:4222
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=likho_transcription
LANGUAGE_GRPC_ADDR=localhost:5030
MEDIA_GRPC_ADDR=localhost:5010

DEFAULT_MODEL=turbo
# The model registry (likho-ml) names the default; DEFAULT_MODEL is used when it cannot.
ML_GRPC_ADDR=localhost:5080
DEVICE=auto
COMPUTE_TYPE=auto
CPU_THREADS=0

WORKER_ENABLED=true
JOB_START=all
JOB_MAX_DELIVER=3
JOB_RETRY_DELAY_SECONDS=30

# How long the start keeps trying to reach NATS before giving up.
NATS_CONNECT_TIMEOUT_SECONDS=120
# Metrics are always at GET /metrics. To also push them (OTLP/HTTP, e.g. the obs profile): http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
