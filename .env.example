# Copy to .env to change a value. The defaults match the likho-infra local stack.

LIKHO_ENV=development
LOG_LEVEL=INFO

GRPC_PORT=5020
HTTP_PORT=4020

MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=likho_transcription
NATS_URL=nats://localhost:4222
LANGUAGE_GRPC_ADDR=localhost:5030
MEDIA_GRPC_ADDR=localhost:5010

# Speech model: turbo, large-v3, medium, small or base. Downloaded on first use.
DEFAULT_MODEL=turbo
# auto = a CUDA GPU when there is one, otherwise the CPU (8-bit).
DEVICE=auto
COMPUTE_TYPE=auto
CPU_THREADS=0

# Take jobs from the event bus. false runs only the gRPC API.
WORKER_ENABLED=true
# all = also take jobs queued while no worker was running; new = only jobs published from now on.
JOB_START=all
JOB_MAX_DELIVER=3
JOB_RETRY_DELAY_SECONDS=30
