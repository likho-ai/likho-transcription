# Committed: no secrets here. Secrets for this environment live in .env.staging.local (ignored by
# git; made by likho-infra/scripts/make-env-secrets.py) or in Kubernetes Secrets (likho-deploy).
# Read order: .env, .env.local, .env.staging, .env.staging.local; a real environment variable wins.

LIKHO_ENV=staging
LOG_LEVEL=INFO
GRPC_PORT=5020
HTTP_PORT=4020

# In-cluster names (Kubernetes namespace likho-staging); likho-deploy sets them up.
NATS_URL=nats://nats:4222
# MONGO_URL carries the password: in .env.staging.local
MONGO_DATABASE=likho_transcription
LANGUAGE_GRPC_ADDR=likho-language:5030
MEDIA_GRPC_ADDR=likho-media:5010

DEFAULT_MODEL=turbo
DEVICE=auto
COMPUTE_TYPE=auto
CPU_THREADS=0
# The model cache is a volume mounted here (see the Dockerfile).
HF_HOME=/models

WORKER_ENABLED=true
JOB_START=all
JOB_MAX_DELIVER=3
JOB_RETRY_DELAY_SECONDS=30
