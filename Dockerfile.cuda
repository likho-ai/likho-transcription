# syntax=docker/dockerfile:1
# GPU image (published as :<tag>-cuda). The same service as the CPU image plus NVIDIA's CUDA 12
# libraries (cuBLAS and cuDNN 9, what CTranslate2 4 needs) from their Python wheels. The GPU
# driver comes from the node through the NVIDIA container runtime; DEVICE=auto then picks cuda
# and float16 by itself. Without a GPU the image still runs, on the CPU.
FROM python:3.12-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv==0.12.17
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable \
    && uv pip install --python .venv/bin/python --no-cache "nvidia-cublas-cu12>=12.4,<13" "nvidia-cudnn-cu12>=9.1,<10"

FROM python:3.12-slim
RUN useradd --system --uid 10001 --no-create-home likho \
    && mkdir /models && chown likho /models
COPY --from=build /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 HF_HOME=/models \
    LD_LIBRARY_PATH=/app/.venv/lib/python3.12/site-packages/nvidia/cublas/lib:/app/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
USER likho
VOLUME /models
EXPOSE 5020 4020
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:4020/readyz', timeout=2).status == 200 else 1)"]
CMD ["likho-transcription"]
